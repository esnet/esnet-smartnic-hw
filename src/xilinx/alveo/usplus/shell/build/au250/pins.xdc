# AU250 shell pin assignments.
# Sources:
#   AMD U250 master XDC rev. 2.04, release 2021-09-09; board files v1.3.
#   https://download.amd.com/opendownload/xlnx/alveo-u250-xdc_20210909.zip
#   https://download.amd.com/opendownload/xlnx/au250_board_files_20200616.zip
#   PG348 v4.0, Alveo Card U200/U250 I/O Constraints.
#   https://docs.amd.com/r/en-US/pg348-cms-subsystem/Alveo-Card-U200/U250-I/O-Constraints

# Serial data pads are placed by the QDMA and CMAC IP GT constraints.

# PCIe.
set_property -dict {PACKAGE_PIN AM11} [get_ports {pcie_refclk_p}]
set_property -dict {PACKAGE_PIN AM10} [get_ports {pcie_refclk_n}]
set_property -dict {PACKAGE_PIN BD21 IOSTANDARD LVCMOS12} [get_ports {pcie_rstn}]

# QSFP reference clocks (MGT_SI570_CLOCK0/1).
set_property -dict {PACKAGE_PIN M11} [get_ports {qsfp_refclk_p[0]}]
set_property -dict {PACKAGE_PIN M10} [get_ports {qsfp_refclk_n[0]}]
set_property -dict {PACKAGE_PIN T11} [get_ports {qsfp_refclk_p[1]}]
set_property -dict {PACKAGE_PIN T10} [get_ports {qsfp_refclk_n[1]}]

# QSFP module control.
set_property -dict {PACKAGE_PIN BE17 IOSTANDARD LVCMOS12 DRIVE 8} [get_ports {qsfp_resetl[0]}]
set_property -dict {PACKAGE_PIN BE20 IOSTANDARD LVCMOS12} [get_ports {qsfp_modprsl[0]}]
set_property -dict {PACKAGE_PIN BE21 IOSTANDARD LVCMOS12} [get_ports {qsfp_intl[0]}]
set_property -dict {PACKAGE_PIN BD18 IOSTANDARD LVCMOS12 DRIVE 8} [get_ports {qsfp_lpmode[0]}]
set_property -dict {PACKAGE_PIN BE16 IOSTANDARD LVCMOS12 DRIVE 8} [get_ports {qsfp_modsell[0]}]
set_property -dict {PACKAGE_PIN BC18 IOSTANDARD LVCMOS12 DRIVE 8} [get_ports {qsfp_resetl[1]}]
set_property -dict {PACKAGE_PIN BC19 IOSTANDARD LVCMOS12} [get_ports {qsfp_modprsl[1]}]
set_property -dict {PACKAGE_PIN AV21 IOSTANDARD LVCMOS12} [get_ports {qsfp_intl[1]}]
set_property -dict {PACKAGE_PIN AV22 IOSTANDARD LVCMOS12 DRIVE 8} [get_ports {qsfp_lpmode[1]}]
set_property -dict {PACKAGE_PIN AY20 IOSTANDARD LVCMOS12 DRIVE 8} [get_ports {qsfp_modsell[1]}]

# Satellite controller.
set_property -dict {PACKAGE_PIN BB19 IOSTANDARD LVCMOS12 DRIVE 4} [get_ports {satellite_uart_0_txd}]
set_property -dict {PACKAGE_PIN BA19 IOSTANDARD LVCMOS12} [get_ports {satellite_uart_0_rxd}]
set_property -dict {PACKAGE_PIN AR20 IOSTANDARD LVCMOS12} [get_ports {satellite_gpio[0]}]
set_property -dict {PACKAGE_PIN AM20 IOSTANDARD LVCMOS12} [get_ports {satellite_gpio[1]}]
set_property -dict {PACKAGE_PIN AM21 IOSTANDARD LVCMOS12} [get_ports {satellite_gpio[2]}]
set_property -dict {PACKAGE_PIN AN21 IOSTANDARD LVCMOS12} [get_ports {satellite_gpio[3]}]

# Complete upstream pin reference
# All package-pin assignments listed in the sources above, including unused
# interfaces and any explicit no-connect entries. Signal names are the upstream
# board names. The shell column identifies the explicit constraints above;
# serial data pads can also be used through the IP GT constraints.
# A dash denotes an unspecified I/O standard or no explicit shell assignment.
# This reference table is comments only and does not apply constraints.
# Listed package pins: 746.
#
# Package pin  Board signal                     I/O standard         Shell port
# AY38         SYSCLK0_300_N                    DIFF_POD12_DCI       -
# AY37         SYSCLK0_300_P                    DIFF_POD12_DCI       -
# AW19         SYSCLK1_300_N                    LVDS                 -
# AW20         SYSCLK1_300_P                    LVDS                 -
# E32          SYSCLK2_300_N                    DIFF_POD12_DCI       -
# F32          SYSCLK2_300_P                    DIFF_POD12_DCI       -
# H16          SYSCLK3_300_N                    DIFF_POD12_DCI       -
# J16          SYSCLK3_300_P                    DIFF_POD12_DCI       -
