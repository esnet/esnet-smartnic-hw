# AU19         USER_SI570_CLOCK_P               LVDS                 -
# AM10         PCIE_REFCLK_N                    -                    pcie_refclk_n
# AM11         PCIE_REFCLK_P                    -                    pcie_refclk_p
# M10          MGT_SI570_CLOCK0_N               -                    qsfp_refclk_n[0]
# M11          MGT_SI570_CLOCK0_P               -                    qsfp_refclk_p[0]
