name: gtm_regs
info: |
  Versal GTM Transceiver Registers
  Ref: AM017, Versal Adaptive SoC GTM Transceivers Architecture Manual
  Source: am017_versal_gtm_regmap_bitfields.csv
  Note: Addresses are DRP word addresses as documented in AM017.
  This file is for reference only; use gtm_regs.yaml for regio elaboration.
regs:
  - default:
      width: 32
      access: rw

  # CH0 status (0x08xx)

  - meta:
      pad_until: 0x0816

  - name: ch0_coe_status_tx_gb_dbg6
    access: ro
    fields:
      - name: tx_fifo_latency
        width: 18
      - name: rsvd
        width: 14

  - meta:
      pad_until: 0x0818

  - name: ch0_coe_status_tx_gb_dbg8
    access: ro
    fields:
      - name: tx_fifo_latency
        width: 18
      - name: rsvd
        width: 14

  - meta:
      pad_until: 0x0836

  - name: ch0_coe_status_rx_gb_dbg6
    access: ro
    fields:
      - name: rx_fifo_latency
        width: 17
      - name: rsvd
        width: 15

  - meta:
      pad_until: 0x0838

  - name: ch0_coe_status_rx_gb_dbg8
    access: ro
    fields:
      - name: rx_fifo_latency
        width: 17
      - name: rsvd
        width: 15

  - meta:
      pad_until: 0x0840

  - name: ch0_coe_status_prbserr_cnt0
    access: ro
    fields:
      - name: do_from_prbserr_lsb
        width: 32

  - name: ch0_coe_status_prbserr_cnt1
