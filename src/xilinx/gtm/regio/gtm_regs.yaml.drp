        width: 32

  - name: ch0_coe_status_prbs_link2reseed_cnt
    access: ro
    fields:
      - name: rsvd
        width: 16
      - name: rxprbserr
        width: 1
      - name: rxprbslocked
        width: 1
      - name: rsvd1
        width: 14

  - meta:
      pad_until: 0x0887

  - name: ch0_coestatus_adapt_loop07
    access: ro
    fields:
      - name: h1_dac
        width: 16
      - name: rsvd
        width: 16

  - name: ch0_coestatus_adapt_loop08
